{
  "name": "mir-frontends",
  "private": true,
  "description": "Front v2 del MIR, en React. Misma estructura, stack y versiones que frontends/ de SISOC (docs/implementaciones/frontend_v2.md).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/mir",
    "build": "npm run build -w apps/mir",
    "tipos": "npm run tipos -w packages/api",
    "chequear": "tsc -p apps/mir --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.1",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "type": "module"
}
